{
  "expo": {
    "name": "GrubnBiteMobile",
    "slug": "GrubnBiteMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_light.jpg",
    "scheme": "grubnbitemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo_light.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo_light.jpg",
        "monochromeImage": "./assets/images/logo_light.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo_light.jpg",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
